<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>ArchiMetrics code review rules</Description>
    <PackageId>ArchiMetrics.CodeReview.Rules</PackageId>
    <Title>Roslyn Code Review</Title>
    <Version>3.0.0</Version>
    <Authors>Jonas Gauffin;Jacob Reimers</Authors>
    <Copyright>Copyright © Reimers.dk 2014-2017</Copyright>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ArchiMetrics.CodeReview.Rules</AssemblyName>
    <PackageTags>Roslyn;Metrics;Analysis</PackageTags>
    <PackageReleaseNotes>Updated to use Roslyn 2.0</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/jjrdk/ArchiMetrics</PackageProjectUrl>
    <PackageLicenseUrl>http://www.opensource.org/licenses/MIT</PackageLicenseUrl>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <!--
      Emits the XML documentation alongside the assembly so it reaches consumers through IntelliSense and
      the NuGet package. Most rules in this library are internal and discovered by reflection; what a
      consumer actually touches is the small public surface that hands those rules to the reviewer.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591 (missing XML comment) is suppressed while documentation coverage is filled in progressively.
      Remove this suppression once coverage is complete, so the compiler starts guarding it.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="**\*.resx" />
    <EmbeddedResource Include="compiler\resources\**\*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ArchiMetrics.Analysis\ArchiMetrics.Analysis.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
  </ItemGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
  </PropertyGroup>
</Project>